NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Omit DATABASE_URL for embedded PostgreSQL development storage.
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ResumeForge <hello@example.com>
STORAGE_ENDPOINT=
STORAGE_BUCKET=resumeforge
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CHROMIUM_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker Compose only: choose independent, long random secrets.
POSTGRES_PASSWORD=
# Set true ONLY for a local HTTP Compose preview; leave false behind production TLS.
ALLOW_INSECURE_LOCAL_COOKIES=false
