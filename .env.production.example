# Copy to .env.production. Keep real secrets out of version control.
# DOMAIN is one canonical hostname, without https://, a path, or a trailing slash.
DOMAIN=resume.example.com
ACME_EMAIL=admin@example.com

# Generate each value independently with: openssl rand -hex 32
# Use hexadecimal POSTGRES_PASSWORD so it is safe inside DATABASE_URL.
SESSION_SECRET=
POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=resumeforge-storage
STORAGE_SECRET_KEY=

# Real email delivery: required for verification and password recovery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM='ResumeForge <hello@example.com>'

# Optional AI provider. Choose a model available to your provider/account.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional Google OAuth. Redirect URI:
# https://resume.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
